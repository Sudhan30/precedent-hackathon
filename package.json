{
  "name": "precedent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:web",
    "deploy": "eve deploy",
    "dev": "tsx scripts/dev.ts",
    "eval": "eve eval",
    "start": "tsx --env-file-if-exists=.env.local apps/server/main.ts",
    "typecheck": "tsc",
    "test": "ALLOW_FIXTURE_PLANNER=true tsx --test tests/*.test.ts",
    "server": "tsx --env-file-if-exists=.env.local apps/server/main.ts",
    "web": "vite apps/web --config apps/web/vite.config.ts",
    "build:web": "vite build apps/web --config apps/web/vite.config.ts",
    "agent:dev": "eve dev",
    "agent:build": "node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js build",
    "agent:start": "node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js start",
    "agent:local": "EVE_DEV=1 PORT=2000 node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js start --host 127.0.0.1",
    "test:browser": "playwright test",
    "demo:record": "playwright test --config rehearsal.config.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "gateway:stream": "tsx --env-file-if-exists=.env.local scripts/stream-gateway.ts",
    "groq:stream": "tsx --env-file-if-exists=.env.local scripts/stream-gateway.ts --groq",
    "setup:atlas": "tsx --env-file-if-exists=.env.local scripts/setup-atlas.ts",
    "verify:atlas": "tsx --env-file-if-exists=.env.local scripts/verify-atlas.ts",
    "verify:raindrop": "tsx --env-file-if-exists=.env.local scripts/verify-raindrop.ts",
    "verify:raindrop:query": "tsx --env-file-if-exists=.env.local scripts/verify-raindrop-query.ts",
    "verify:raindrop:governance": "tsx --env-file-if-exists=.env.local scripts/verify-raindrop-governance.ts",
    "reset:demo": "tsx --env-file-if-exists=.env.local scripts/reset-demo.ts",
    "demo:prepare": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.data/local-login.env scripts/prepare-demo.ts",
    "setup:user": "tsx --env-file-if-exists=.env.local scripts/setup-user.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.58",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mongodb-js/agent-engine-sdk-memory": "0.11.8",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@vercel/connect": "2.2.0",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.128",
    "eve": "^0.74.0",
    "express": "^5.2.1",
    "modelence": "^0.26.2",
    "mongodb": "^6.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@types/node": "24.x",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": "24.x"
  }
}
