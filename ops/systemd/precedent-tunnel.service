[Unit]
Description=Precedent Cloudflare Tunnel
After=network-online.target precedent-api.service
Wants=network-online.target precedent-api.service

[Service]
WorkingDirectory=@PROJECT_ROOT@
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --token-file @PROJECT_ROOT@/.data/cloudflare-precedent.token
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=default.target
