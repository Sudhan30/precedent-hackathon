# Optional live integrations. Keep real values only in .env.local (Git ignored).
AUTH_MODE=demo
# Live planning is the default. Enable only for explicit scripted demos/tests.
ALLOW_FIXTURE_PLANNER=false
# Modelence authentication requires MongoDB and assigned user roles.
MODELENCE_SITE_URL=http://127.0.0.1:4311
MODELENCE_TRACKING_ENABLED=false
MONGODB_URI=
# Enable only after Atlas search indexes report READY/queryable.
ATLAS_SEARCH_ENABLED=false
# compact: three indexes; full: four indexes (requires cluster capacity).
ATLAS_SEARCH_LAYOUT=compact
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_RERANK_MODEL=rerank-2.5-lite
AI_GATEWAY_API_KEY=
# Direct Groq model access; independent of Vercel billing.
GROQ_API_KEY=
# Enables backend OTLP export and native eve instrumentation; trace visibility requires verification.
RAINDROP_WRITE_KEY=
# Separate read key for optional automated trace visibility verification.
RAINDROP_QUERY_API_KEY=
EVE_WORKER_URL=
# Optional: MongoDB Atlas Agent Engine procedural memory (Public Preview) indexes learned playbooks.
AGENTIC_MEMORY_CLIENT_ID=
AGENTIC_MEMORY_CLIENT_SECRET=
AGENTIC_MEMORY_PROJECT_ID=
AGENTIC_MEMORY_BASE_URL=
# Local demo defaults; omit to use these defaults.
PORT=4311
PRECEDENT_DB=.data/precedent.db
CONNECTOR_DB=.data/connector.db

# For public hosting, set NODE_ENV=production, AUTH_MODE=modelence and
# MODELENCE_SITE_URL=https://your-domain. See HOSTING.md before publishing.

# Optional local account provisioning. Remove real setup credentials after use.
PRECEDENT_SETUP_URL=http://127.0.0.1:4311
PRECEDENT_SETUP_EMAIL=
PRECEDENT_SETUP_PASSWORD=
PRECEDENT_SETUP_ROLE=employee

# Optional login shortcuts; each still requires the actual account password.
# PRECEDENT_LOGIN_ALIASES={"admin":"your-admin@example.com"}
